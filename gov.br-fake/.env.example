# Simulador local e demonstrativo. Mesmo publicado em uma Vercel Preview, ele
# continua sendo apenas homologação e nunca deve ser tratado como Gov.br real.
# Na Vercel, configure NODE_ENV=production nas Environment Variables do projeto.
# Para começar localmente: copie este arquivo para .env, preencha os campos
# necessários e nunca adicione o .env ao Git.
NODE_ENV=development

# Redis REST é opcional no desenvolvimento e obrigatório em produção.
# Use REDIS_NAMESPACE=atestaponto:staging na homologação. O prefixo gov:* evita
# colisão com o ponto-escolar no Redis compartilhado. Configure URL/token somente
# no painel da Vercel e não coloque credenciais reais neste arquivo.
REDIS_ENABLED=false
REDIS_NAMESPACE=atestaponto:local
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bind e porta usados somente por npm start. Use HOST=0.0.0.0 quando a rede
# Docker exigir; nunca use 0.0.0.0 como URL no navegador. A Function da Vercel
# não executa listen() e não precisa de HOST, GOVBR_FAKE_PORT ou PORT.
HOST=127.0.0.1
GOVBR_FAKE_PORT=4000

# Alias de GOVBR_FAKE_PORT aceito pelo código. GOVBR_FAKE_PORT tem precedência.
# PORT=4000

# Devem coincidir com GOVBR_FAKE_CLIENT_ID e GOVBR_FAKE_CLIENT_SECRET
# configurados no ponto-escolar. O secret real deve existir somente no .env
# local ignorado pelo Git ou no painel da Vercel.
# Gere um valor e configure exatamente o mesmo nos dois projetos:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
GOVBR_FAKE_CLIENT_ID=ponto-escolar
GOVBR_FAKE_CLIENT_SECRET=

# URLs do sistema principal usadas pelo fluxo OAuth/OIDC simulado. Na Preview,
# substitua 127.0.0.1 pela URL HTTPS pública do projeto ponto-escolar; as duas
# variáveis devem apontar para o mesmo domínio Vercel.
PONTO_ESCOLAR_REDIRECT_URI=http://127.0.0.1:3000/auth/govbr/callback
PONTO_ESCOLAR_START_URL=http://127.0.0.1:3000/auth/govbr/login

# Identidade fictícia usada pelo simulador. Preencha apenas no ambiente privado.
# O sub deve constar em ADMIN_GOVBR_SUBS do ponto-escolar para acesso admin.
# Use somente dados de demonstração, sem dados pessoais reais.
GOVBR_FAKE_ADMIN_LOGIN=adminlocal
GOVBR_FAKE_ADMIN_PASSWORD=replace-with-demo-password
GOVBR_FAKE_ADMIN_SUB=
GOVBR_FAKE_ADMIN_NAME=
GOVBR_FAKE_ADMIN_EMAIL=

# Contas administrativas locais adicionais. Cada identidade exige os cinco
# campos; os perfis e escopos continuam sendo resolvidos pelo ponto-escolar.
GOVBR_FAKE_ADMIN_SEDUC_LOGIN=
GOVBR_FAKE_ADMIN_SEDUC_PASSWORD=
GOVBR_FAKE_ADMIN_SEDUC_SUB=
GOVBR_FAKE_ADMIN_SEDUC_NAME=
GOVBR_FAKE_ADMIN_SEDUC_EMAIL=

GOVBR_FAKE_ADMIN_DRE1_LOGIN=
GOVBR_FAKE_ADMIN_DRE1_PASSWORD=
GOVBR_FAKE_ADMIN_DRE1_SUB=
GOVBR_FAKE_ADMIN_DRE1_NAME=
GOVBR_FAKE_ADMIN_DRE1_EMAIL=

GOVBR_FAKE_ADMIN_DRE2_LOGIN=
GOVBR_FAKE_ADMIN_DRE2_PASSWORD=
GOVBR_FAKE_ADMIN_DRE2_SUB=
GOVBR_FAKE_ADMIN_DRE2_NAME=
GOVBR_FAKE_ADMIN_DRE2_EMAIL=

GOVBR_FAKE_ADMIN_VICE_DIRETOR_LOGIN=
GOVBR_FAKE_ADMIN_VICE_DIRETOR_PASSWORD=
GOVBR_FAKE_ADMIN_VICE_DIRETOR_SUB=
GOVBR_FAKE_ADMIN_VICE_DIRETOR_NAME=
GOVBR_FAKE_ADMIN_VICE_DIRETOR_EMAIL=

GOVBR_FAKE_ADMIN_SECRETARIA_LOGIN=
GOVBR_FAKE_ADMIN_SECRETARIA_PASSWORD=
GOVBR_FAKE_ADMIN_SECRETARIA_SUB=
GOVBR_FAKE_ADMIN_SECRETARIA_NAME=
GOVBR_FAKE_ADMIN_SECRETARIA_EMAIL=

GOVBR_FAKE_ADMIN_COORDENADOR_LOGIN=
GOVBR_FAKE_ADMIN_COORDENADOR_PASSWORD=
GOVBR_FAKE_ADMIN_COORDENADOR_SUB=
GOVBR_FAKE_ADMIN_COORDENADOR_NAME=
GOVBR_FAKE_ADMIN_COORDENADOR_EMAIL=
