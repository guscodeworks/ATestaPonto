# Copie para .env nesta pasta. Nunca reutilize segredos/dados de outro ambiente.
# Nao ha carregamento do .env do gateway ou do backend-spring.
SPRING_HTTP_PORT=18081
DB_NAME=atestaponto_standalone
DB_USER=atestaponto_local
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Tres valores independentes, aleatorios e com pelo menos 32 bytes cada.
INTERNAL_API_SHARED_KEY=
JWT_SECRET=
SESSION_SECRET=

# Opt-in exclusivo para HTTP em loopback. Para HTTPS: production e true.
NODE_ENV=development
ADMIN_SESSION_SECURE=false
ADMIN_SESSION_TTL_SECONDS=7200
CORS_ORIGIN=http://localhost:18081
APP_BASE_URL=http://localhost:18081

# Provedor externo autorizado; nao inicia Express nem ATestaID.
# URLs reais do provedor e credenciais devem ser preenchidas no .env local.
GOVBR_AUTHORIZE_URL=
GOVBR_TOKEN_URL=
GOVBR_USERINFO_URL=
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_REDIRECT_URI=http://localhost:18081/auth/govbr/callback
GOVBR_LOGOUT_URL=/

# Desligado por padrao: nao envia e-mails reais no ambiente isolado.
# Ao habilitar, use SMTP de testes. false usa STARTTLS; true usa TLS implicito.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=

# Sem confianca em X-Forwarded-* no acesso local direto.
SERVER_FORWARD_HEADERS_STRATEGY=none
SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=
SERVER_TOMCAT_REMOTEIP_TRUSTED_PROXIES=
