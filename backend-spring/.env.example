DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# npm run dev:spring compartilha REDIS_ENABLED e REDIS_NAMESPACE do gateway.
# Mesmo Redis (banco 0), com host/porta alcancaveis pelo processo Spring.
# Configure o endereco explicitamente; nao ha remapeamento de hostname Docker.
# Exportar tambem habilitacao e namespace ao executar Maven diretamente.
REDIS_HOST=
REDIS_PORT=6379

BRASILAPI_BASE_URL=https://brasilapi.com.br
BRASILAPI_CONNECT_TIMEOUT=3s
BRASILAPI_READ_TIMEOUT=8s

# Placeholder vazio: mesma chave privada recebida pelo Node (mínimo 32 bytes UTF-8).
# Obrigatória para iniciar o Spring; não há fallback ou modo sem assinatura.
# Maven/Spring não carregam este .env automaticamente: exportar as variáveis.
# npm run dev:spring carrega este arquivo sem sobrescrever variáveis externas.
# Precedência: ambiente externo > este arquivo > .env do Node (valores compartilhados).
# Ver README.md. Nunca versionar o valor real ou expor ao frontend/logs.
INTERNAL_API_SHARED_KEY=

# APIs publicas de ponto: os mesmos valores do gateway, sem gerar novas chaves.
JWT_SECRET=
SESSION_SECRET=
CORS_ORIGIN=
FUNCIONARIO_JWT_EXPIRES_IN=20m
FIRST_ACCESS_TOKEN_EXPIRES_IN=10m
BCRYPT_SALT_ROUNDS=12
LOGIN_FAILURE_DELAY_MS=2000
RATE_LIMIT_IP_MAX=2000
LOGIN_RATE_LIMIT_IP_FAILURE_MAX=100
POINT_RATE_LIMIT_WINDOW_MS=300000
POINT_RATE_LIMIT_MAX=500
# QR compartilha cookie/sessao Redis com as paginas Express.
REDIS_ENABLED=false
# REDIS_NAMESPACE=atestaponto:local
# E-mails usam MAIL_ENABLED, SMTP_HOST/PORT/USER/PASS/SECURE, MAIL_FROM e APP_BASE_URL
# ja compartilhados com o gateway; nunca registre destinatario ou codigo.
