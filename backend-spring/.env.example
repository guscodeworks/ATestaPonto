# Spring carrega ./.env (diretorio de trabalho, ex.: ./mvnw spring-boot:run em backend-spring/).
# Precedência: variáveis de ambiente/-D > este arquivo. Ausente, o Spring usa só o ambiente (Docker).
# Mesmo formato dotenv do gateway (aspas, export, # e multilinhas entre aspas).
# Apenas as chaves abaixo são lidas daqui; propriedades Spring (ex.: SERVER_PORT) vêm do ambiente.
# Nunca versionar valores reais.
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Mesmo Redis (banco 0) e REDIS_NAMESPACE do gateway, com host/porta alcançáveis pelo Spring.
# Sessão administrativa Spring sempre exige Redis, mesmo com REDIS_ENABLED=false.
# Namespace exclusivo: <REDIS_NAMESPACE>:admin:spring-session (padrão atestaponto:production).
REDIS_ENABLED=false
REDIS_NAMESPACE=atestaponto:local
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
ADMIN_SESSION_SECURE=true
ADMIN_SESSION_TTL_SECONDS=7200

# OAuth Gov.br (cliente próprio do Spring).
GOVBR_AUTHORIZE_URL=
GOVBR_TOKEN_URL=
GOVBR_USERINFO_URL=
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_REDIRECT_URI=
GOVBR_LOGOUT_URL=/

BRASILAPI_BASE_URL=https://brasilapi.com.br
BRASILAPI_CONNECT_TIMEOUT=3s
BRASILAPI_READ_TIMEOUT=8s

# Mesma chave privada recebida pelo Node (mínimo 32 bytes UTF-8); obrigatória, sem fallback.
INTERNAL_API_SHARED_KEY=

# APIs públicas de ponto: os mesmos valores do gateway, sem gerar novas chaves.
JWT_SECRET=
SESSION_SECRET=
CORS_ORIGIN=
APP_BASE_URL=
FUNCIONARIO_JWT_EXPIRES_IN=20m
FIRST_ACCESS_TOKEN_EXPIRES_IN=10m
BCRYPT_SALT_ROUNDS=12
LOGIN_FAILURE_DELAY_MS=2000
RATE_LIMIT_IP_MAX=2000
LOGIN_RATE_LIMIT_IP_FAILURE_MAX=100
POINT_RATE_LIMIT_WINDOW_MS=300000
POINT_RATE_LIMIT_MAX=500

# E-mail compartilhado com o gateway; nunca registre destinatário ou código.
MAIL_ENABLED=false
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
