# Ambiente da aplicação. Use "development" localmente. Na Vercel Preview,
# configure NODE_ENV=production nas Environment Variables do projeto.
# Para começar localmente: copie este arquivo para .env, preencha os campos
# obrigatórios e nunca adicione o .env ao Git.
NODE_ENV=development

# Redis REST é opcional no desenvolvimento e obrigatório em produção.
# Use REDIS_NAMESPACE=atestaponto:staging na homologação e configure URL/token
# somente no painel da Vercel. Não coloque credenciais reais neste arquivo.
REDIS_ENABLED=false
REDIS_NAMESPACE=atestaponto:local
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Endereço de escuta usado somente por npm start/npm run dev. A Function da
# Vercel não executa listen() e não precisa de HOST ou PORT configurados.
HOST=127.0.0.1
PORT=3000

# Banco MySQL.
# DB_HOST, DB_USER e DB_NAME são obrigatórias.
# DB_PORT, DB_CONNECTION_LIMIT e DB_SSL_ENABLED são opcionais.
# DB_PASSWORD pode ficar vazia em desenvolvimento se o MySQL local não usar senha;
# em produção, o código exige DB_PASSWORD ou DB_PASS.
# Para Aiven, use o host/porta/usuário/senha fornecidos pelo serviço, ative o
# SSL e informe o certificado CA completo codificado em Base64.
# DB_SSL_CA_BASE64 é obrigatório somente quando DB_SSL_ENABLED=true.
# Exemplo de conversão local, sem enviar o certificado a terceiros:
# base64 < ca.pem | tr -d '\n'

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=ponto
DB_CONNECTION_LIMIT=2
DB_SSL_ENABLED=false
DB_SSL_CA_BASE64=

# Aliases legados aceitos pelo código. Mantenha comentados quando usar as
# variáveis principais acima. Os scripts de banco leem DB_NAME diretamente,
# por isso prefira DB_NAME em vez de DB.
# DB_PASS=
# DB=ponto

# JWT_SECRET, JWT_EXPIRES_IN e SESSION_SECRET são obrigatórias.
# Use secrets diferentes, com pelo menos 32 caracteres e combinação de letras
# maiúsculas, minúsculas, números e símbolos. Configure os valores reais apenas
# no .env local ignorado pelo Git ou no painel da Vercel.
# Gere JWT_SECRET e SESSION_SECRET separadamente com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
SESSION_SECRET=

# Tempo de vida da sessão administrativa em milissegundos.
# Opcional: padrão de 2 horas (7200000), mínimo de 1 minuto e máximo de 24 horas.
ADMIN_SESSION_TTL_MS=7200000

# Opcional. O padrão do JWT de funcionário é 20m.
FUNCIONARIO_JWT_EXPIRES_IN=20m

# Espera, em milissegundos, aplicada pelo servidor apos cada login invalido.
# O padrao e 2 segundos; mantenha entre 500 e 10000.
LOGIN_FAILURE_DELAY_MS=2000

# Obrigatória. Aceita uma ou mais origens separadas por vírgula. Na Preview,
# informe a origem HTTPS pública do próprio ponto-escolar.
# O valor "*" só é aceito fora de produção.
CORS_ORIGIN=http://127.0.0.1:3000

# Opcionais. Limites do fluxo de login e registro de ponto.
POINT_RATE_LIMIT_WINDOW_MS=300000
POINT_RATE_LIMIT_MAX=500

# Integração local com o gov.br-fake.
# Client ID, client secret e redirect URI são obrigatórios e precisam coincidir
# nos dois projetos. GOVBR_FAKE_BASE_URL é opcional em desenvolvimento e usa
# http://127.0.0.1:4000 como padrão. Na Preview, GOVBR_FAKE_BASE_URL deve ser a
# URL HTTPS pública do projeto gov.br-fake e GOVBR_FAKE_REDIRECT_URI deve usar a
# URL HTTPS pública deste projeto ponto-escolar.
GOVBR_FAKE_BASE_URL=http://127.0.0.1:4000
GOVBR_FAKE_CLIENT_ID=ponto-escolar
GOVBR_FAKE_CLIENT_SECRET=
GOVBR_FAKE_REDIRECT_URI=http://127.0.0.1:3000/auth/govbr/callback

# Autorização administrativa interna do ponto-escolar.
# Ao menos ADMIN_GOVBR_SUBS ou ADMIN_GOVBR_EMAILS deve conter um valor.
# Use vírgulas para autorizar mais de um identificador e configure os valores
# exclusivamente no .env privado ou no painel da Vercel.
ADMIN_GOVBR_SUBS=
ADMIN_GOVBR_EMAILS=

# Envio de credenciais iniciais por e-mail. Para Gmail, crie uma senha de
# aplicativo na conta atestaponto@gmail.com; nunca use a senha normal.
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=atestaponto@gmail.com
SMTP_PASS=replace-with-gmail-app-password
MAIL_FROM="Atesta Ponto <atestaponto@gmail.com>"
APP_BASE_URL=http://127.0.0.1:3000

# Configuração alternativa para um provedor Gov.br/OIDC real.
# Remova ou esvazie GOVBR_FAKE_BASE_URL e as credenciais GOVBR_FAKE_* antes
# de ativar estas variáveis. Os endpoints e credenciais dependem do cadastro
# oficial da aplicação.
# GOVBR_AUTHORIZE_URL=
# GOVBR_TOKEN_URL=
# GOVBR_USERINFO_URL=
# GOVBR_CLIENT_ID=
# GOVBR_CLIENT_SECRET=
# GOVBR_REDIRECT_URI é o alias/fallback de GOVBR_FAKE_REDIRECT_URI.
# GOVBR_REDIRECT_URI=
